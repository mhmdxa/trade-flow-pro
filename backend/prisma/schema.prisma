datasource db {
  provider = "sqlite"
  url      = "file:./tradeflow.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trades         Trade[]
  journals       Journal[]
  strategies     Strategy[]
  riskSettings   RiskSetting?
  riskLogs       RiskLog[]
  calendarEvents CalendarEvent[]
  analytics      Analytics[]
  reports        Report[]
  settings       Setting?
}

model Trade {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  date       DateTime @default(now())
  symbol     String
  type       String   // "Buy" | "Sell"
  lots       Float
  entryPrice Float
  exitPrice  Float?
  stopLoss   Float?
  takeProfit Float?
  pnl        Float?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Journal {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime @default(now())
  title     String
  content   String
  mood      String? 
  rating    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Strategy {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  description String?
  winRate     Float?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RiskSetting {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id])
  initialBalance          Float    @default(100000)
  dailyLossLimitPercent   Float    @default(5.0)
  maxDrawdownLimitPercent Float    @default(10.0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model RiskLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime @default(now())
  event     String
  severity  String   // "high", "medium", "low"
  createdAt DateTime @default(now())
}

model CalendarEvent {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  date        DateTime
  title       String
  description String?
  impact      String   // "high", "medium", "low"
  createdAt   DateTime @default(now())
}

model Analytics {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  date        DateTime @default(now())
  winRate     Float
  profitFactor Float
  totalTrades Int
  createdAt   DateTime @default(now())
}

model Report {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime @default(now())
  type      String   // "pdf", "excel"
  url       String?
  createdAt DateTime @default(now())
}

model Setting {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  theme     String   @default("dark")
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
